# ── PALMA environment ────────────────────────────────────────────────────────
# Copy to .env.local for development. Never commit real secrets.

# PostgreSQL. Required everywhere, including at build time: PALMA reads every
# public page from the database, and there is no fallback dataset behind it.
#
# On a managed Postgres behind a pooler (Supabase, Neon), this is the POOLED
# connection — Supabase's port 6543 with ?pgbouncer=true. Each serverless
# function opens its own connection and Postgres has a few hundred, so pointing
# the app at the direct port exhausts the database on the first busy evening.
#
#   Supabase pooled:  postgresql://postgres.<ref>:***@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://palma:***@localhost:5432/palma?schema=public"

# The UNPOOLED connection, used only by SQL migrations. A pooler in transaction
# mode cannot run DDL or take advisory locks, so `npm run db:migrate` needs the
# direct port. Leave unset locally, where they are the same.
#
#   Supabase direct:  postgresql://postgres:***@db.<ref>.supabase.co:5432/postgres
DIRECT_URL=""

# Optional. Runtime SQL pool size per process. Builds use a wider pool
# automatically; set this only if a long-running server needs more headroom.
PG_POOL_MAX=""

# 32+ byte secret used to sign session cookies and verification signatures.
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-change-me-change-me-change-me-change-me"

# The address the public actually visits.
#
# Not decoration, and the one setting most often left wrong. It is written into
# every share link a creator copies, every link in every email PALMA sends,
# every canonical tag, the sitemap and the Open Graph card on a winner's
# honour. Point it at localhost and all of those point at the reader's own
# machine: a creator puts their record link in a press kit and it goes nowhere,
# an invitation arrives with a sign-in link that works only for the person who
# sent it. Nothing errors. It just quietly does not work, for everyone.
#
# Leaving this unset is safe: it defaults to the line below. Set it to
# http://localhost:3000 only while working locally, and only in .env.local,
# never anywhere that serves anybody else. A production server refuses to start
# on a loopback address.
NEXT_PUBLIC_SITE_URL="https://palmaawards.com"


# ── Mail ─────────────────────────────────────────────────────────────────────
# PALMA writes as four named mailboxes (src/server/email/addresses.ts) and has
# no noreply address. EMAIL_FROM is only the fallback for a message that names
# no mailbox; in practice every template names one.
EMAIL_FROM="PALMA <laurels@palmaawards.com>"

# Resend. A send-only key is enough — nothing reads the provider's account.
# Without it, development logs each message instead of sending, and production
# records the message as failed rather than pretending it went.
RESEND_API_KEY=""

# A temporary sender for while the sending domain is being verified.
#
# A provider will not let you send as laurels@palmaawards.com until DNS proves
# you own the domain — correctly, or anyone could. Until then every message
# fails on an error about DNS. Set this and mail goes out from a
# provider-supplied address instead: the subject is prefixed [PALMA sandbox],
# the body says why, and the reply address is still the real mailbox.
#
# UNSET IT the moment the domain verifies. Nothing else changes.
EMAIL_SANDBOX_FROM=""

# Lets the provider tell PALMA what became of a message — delivered, bounced,
# reported as spam. Without it a message reads "sent" for ever and a dead
# address goes on looking like one PALMA is successfully writing to.
#
# Point the provider's webhook at /api/webhooks/resend and paste its signing
# secret here. The route refuses everything while this is unset, because an
# unauthenticated endpoint that can mark any address undeliverable is a way to
# cut somebody off from their own account.
RESEND_WEBHOOK_SECRET=""


# ── Age and identity assurance ───────────────────────────────────────────────
# Both routes are built. Which one runs is a switch in /admin/settings; these
# only decide whether the automatic one is available to select.
#
# PALMA stores a status, a provider reference, a result hash and a date. Never
# a document, a date of birth, an ID number or an address.
#
# "stub" performs no assurance at all and is for development only. With no
# provider key configured, manual review at the moderation desk is in force —
# which is a working mode, not a fault.
AGE_VERIFICATION_PROVIDER="stub"
AGE_VERIFICATION_API_KEY=""


# ── Scheduled work ───────────────────────────────────────────────────────────
# Shared secret for the retention sweep. Schedule it daily:
#
#   curl -fsS -X POST https://palmaawards.com/api/cron/retention \
#     -H "Authorization: Bearer $CRON_SECRET"
#
# The route refuses everything while this is unset: an unauthenticated endpoint
# that deletes rows is worse than no endpoint, so it fails closed.
CRON_SECRET=""


# ── Portrait storage (Cloudflare R2) ─────────────────────────────────────────
# Where creator portraits live. All four or none: with any one missing, the
# bytes go into the database column instead, which still works and is the right
# answer for local development. Half a configuration is the dangerous state —
# an upload that reaches R2 and a delete that cannot would leave an image PALMA
# believes it removed — so anything short of all four counts as none, and the
# server says so on boot.
#
# The bucket is private and stays private. Portraits are served through PALMA's
# own /creators/{slug}/portrait/{checksum} route rather than from a public
# bucket URL, which is what keeps "withdrawn means gone" enforceable in one
# place: the database row decides what is served, so a portrait taken down
# stays down even if the delete against R2 failed.
#
# Create the token in the Cloudflare dashboard under R2 → Manage API tokens,
# scoped to Object Read & Write on this bucket alone.
R2_ACCOUNT_ID="ad2b6bd38d951c12957cf638100c4ee5"
R2_BUCKET="44palma"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
