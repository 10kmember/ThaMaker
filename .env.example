# ── PALMA environment ────────────────────────────────────────────────────────
# Copy to .env.local for development. Never commit real secrets.

# PostgreSQL. Required everywhere, including at build time: PALMA reads every
# public page from the database, and there is no fallback dataset behind it.
DATABASE_URL="postgresql://palma:palma@localhost:5432/palma?schema=public"

# 32+ byte secret used to sign session cookies and verification signatures.
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-change-me-change-me-change-me-change-me"

# Canonical public origin, used for canonical URLs, OG tags and sitemaps.
NEXT_PUBLIC_SITE_URL="https://palmaawards.com"

# Transactional email — Resend. PALMA sends nomination verification codes and
# receipts through it, so a nomination cannot be completed without it.
#
# Required in production: without a key the server refuses to accept a
# nomination rather than silently dropping the code. In development the code is
# written to the server log instead, so the flow can be exercised offline.
EMAIL_FROM="PALMA <honours@palmaawards.com>"
RESEND_API_KEY=""

# Age / identity verification provider (third party). PALMA stores only the
# provider reference and status — never identity documents.
AGE_VERIFICATION_PROVIDER="stub"
AGE_VERIFICATION_API_KEY=""
