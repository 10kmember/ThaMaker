// PALMA — The Creator Honours
// Institutional data model. Every award-bearing fact in this schema is meant to
// outlive the season that produced it: nominations, scores, honours and the
// PALMA Roll of Honour are append-friendly and audited rather than mutable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  /// The pooled connection, used by the application.
  ///
  /// Serverless functions each open their own connection, and a Postgres
  /// instance has a few hundred — so on Supabase, Neon or anything similar
  /// this must be the pooler (port 6543 on Supabase, `?pgbouncer=true`), or
  /// the first busy evening exhausts the database rather than the function.
  url = env("DATABASE_URL")

  /// The unpooled connection, used only by migrations.
  ///
  /// A pooler in transaction mode cannot run DDL or advisory locks, so
  /// `prisma migrate` and `db push` need the direct port (5432). Falls back to
  /// DATABASE_URL when unset, which is correct for a local database where the
  /// two are the same thing.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  visitor
  creator
  judge
  /// Editorial and moderation are one job: the person who writes a creator's
  /// record is the person who screens a claim about it.
  moderator
  admin
  super_admin
}

enum SeasonStage {
  announced
  nominations_open
  nominations_closed
  shortlisting
  shortlist_announced
  judging
  finalists_announced
  winners_announced
  archived
}

enum VerificationStatus {
  unverified
  pending
  verified
  failed
  expired
  revoked
}

enum NominationSource {
  /// Found through PALMA and nominated from the site.
  organic
  /// Arrived through a creator's own nomination link.
  referral
  /// Entered by PALMA itself, e.g. a category the panel wants contested.
  editorial
}

/// The life of a single audience nomination.
enum NominationStatus {
  /// Written, but the nominator's email is not yet verified.
  pending_verification
  /// Verified and committed. This is the only state that counts.
  counted
  /// Refused by integrity screening or moderation.
  rejected
  /// Withdrawn by the nominator.
  withdrawn
}

/// The life of a creator's candidacy in one category of one season.
enum CandidacyStatus {
  under_review
  eligible
  ineligible
  shortlisted
  finalist
  winner
  withdrawn
}

enum EvidenceKind {
  external_link
  press_mention
  metric_statement
  testimonial
  award_record
  other
}

enum AssignmentStatus {
  assigned
  in_progress
  completed
  recused
  reassigned
}

enum ConflictKind {
  personal_relationship
  commercial_relationship
  representation
  employment
  competitor
  other
}

enum ConflictStatus {
  declared
  upheld
  dismissed
}

enum HonourKind {
  shortlist
  finalist
  winner
  special_recognition
  /// THE PALMA. One a year, no category, no candidacy behind it.
  the_palma
}

enum HonourState {
  active
  revoked
}

enum ArticleStatus {
  draft
  in_review
  scheduled
  published
  archived
}

enum SponsorTier {
  headline
  category_partner
  supporting
  media
}

enum ReportReason {
  impersonation
  fabricated_achievement
  explicit_content
  harassment
  ineligible_creator
  vote_manipulation
  other
}

enum ReportStatus {
  open
  investigating
  actioned
  dismissed
}

enum ModerationActionKind {
  content_removed
  profile_suspended
  nomination_rejected
  honour_revoked
  creator_banned
  warning_issued
  restored
}

enum ClaimStatus {
  submitted
  awaiting_information
  escalated
  approved
  rejected
  withdrawn
}

/// Why a claim reached manual age assurance rather than the provider's
/// automated path.
enum VerificationCaseReason {
  provider_unavailable
  provider_exception
  result_requires_review
  reverification_due
}

enum VerificationCaseStatus {
  open
  awaiting_information
  verified
  refused
  abandoned
}

enum ConsequentialActionKind {
  account_ban
  honour_revocation
  /// THE PALMA. Proposed at the desk, conferred by a second person.
  the_palma_conferral
}

enum NotificationChannel {
  email
  in_app
}

enum EmailDeliveryStatus {
  /// Written, not yet handed to the provider.
  queued
  /// The provider accepted it.
  sent
  /// It reached the recipient's mail server.
  delivered
  /// It came back. The address does not work, and PALMA has not told them.
  bounced
  /// The recipient marked it as spam. Worse than a bounce: it arrived and was
  /// unwelcome, so PALMA stops sending them anything optional.
  complained
  /// The provider refused it, or could not be reached.
  failed
  /// Not sent on purpose — the account muted this channel, or there is no
  /// provider configured in this environment.
  suppressed
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & access
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  name            String
  passwordHash    String
  role            Role      @default(creator)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  creator                  Creator?
  judge                    Judge?
  sessions                 AuthSession[]
  auditLogs                AuditLog[]
  notifications            Notification[]
  moderationActions        ModerationAction[]      @relation("ModerationActor")
  reportsFiled             Report[]                @relation("ReportReporter")
  articlesAuthored         Article[]               @relation("ArticleAuthor")
  notificationPrefs        NotificationPreference?
  claimsMade               CreatorClaim[]          @relation("ClaimClaimant")
  claimsDecided            CreatorClaim[]          @relation("ClaimReviewer")
  invitationsIssued        ClaimInvitation[]       @relation("InvitationIssuer")
  creatorNotes             CreatorNote[]           @relation("CreatorNoteAuthor")
  verificationCasesDecided VerificationCase[]      @relation("VerificationCaseReviewer")
  actionsRequested         ConsequentialAction[]   @relation("ConsequentialRequester")
  actionsApproved          ConsequentialAction[]   @relation("ConsequentialApprover")
  passwordResets           PasswordResetToken[]
  emailChanges             EmailChangeRequest[]
  emailDeliveries          EmailDelivery[]
  emailSubscriptions       EmailSubscription[]

  @@index([role])
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  csrfSecret String
  userAgent  String?
  ipHash     String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// What an account has asked to hear about, by channel.
///
/// These gate the Gazette and the announcements. They never gate a message
/// PALMA owes the account regardless — a password reset, a security notice, a
/// decision on their own record — because an institution that lets you switch
/// off the news that your honour was revoked is not keeping a record.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  /// Shortlist, finalist and winner announcements across the season.
  seasonAnnouncements Boolean @default(true)
  /// Movement on a nomination or candidacy that concerns this account.
  nominationUpdates   Boolean @default(true)
  /// Honours conferred on this account's creator record.
  honourAnnouncements Boolean @default(true)
  /// The PALMA Journal digest.
  journalDigest       Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Creators
// ─────────────────────────────────────────────────────────────────────────────

model Creator {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayName String
  pronouns    String?
  countryCode String   @db.Char(2)
  city        String?
  headline    String?
  biography   String?  @db.Text
  portraitUrl String?
  portraitAlt String?
  websiteUrl  String?
  isPublished Boolean  @default(false)
  isClaimed   Boolean  @default(false)
  isSuspended Boolean  @default(false)
  userId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  verification      CreatorVerification?
  candidacies       Candidacy[]
  honours           Honour[]
  achievements      Achievement[]
  links             CreatorLink[]
  reports           Report[]             @relation("ReportSubjectCreator")
  claims            CreatorClaim[]
  invitations       ClaimInvitation[]
  staffNotes        CreatorNote[]
  verificationCases VerificationCase[]
  emailDeliveries   EmailDelivery[]
  objections        RecordObjection[]
  portrait          CreatorPortrait?

  /// The creator's own nomination link: palmaawards.com/nominate/<slug>.
  /// Issued once the profile is claimed and verified.
  referralEnabled Boolean @default(false)

  @@index([countryCode])
  @@index([isPublished])
}

model CreatorLink {
  id        String @id @default(cuid())
  creatorId String
  label     String
  url       String
  position  Int    @default(0)

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

/// Age / identity assurance is delegated to a specialist third-party provider.
/// PALMA deliberately stores no identity documents — only the minimum state
/// required to prove that assurance happened.
model CreatorVerification {
  id                String             @id @default(cuid())
  creatorId         String             @unique
  status            VerificationStatus @default(unverified)
  provider          String?
  providerReference String?
  method            String?
  verifiedAt        DateTime?
  expiresAt         DateTime?
  lastCheckedAt     DateTime?
  failureCode       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Seasons & categories
// ─────────────────────────────────────────────────────────────────────────────

model AwardYear {
  id                 String      @id @default(cuid())
  year               Int         @unique
  title              String
  stage              SeasonStage @default(announced)
  tagline            String?
  summary            String?     @db.Text
  nominationsOpenAt  DateTime?
  nominationsCloseAt DateTime?
  shortlistAt        DateTime?
  finalistsAt        DateTime?
  ceremonyAt         DateTime?
  isCurrent          Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  categories      Category[]
  candidacies     Candidacy[]
  honours         Honour[]
  judges          JudgePanelMembership[]
  sponsorships    Sponsorship[]
  featureSettings FeatureSetting[]
  events          PalmaEvent[]

  @@index([stage])
}

model Category {
  id              String   @id @default(cuid())
  awardYearId     String
  slug            String
  name            String
  strapline       String?
  description     String   @db.Text
  eligibility     String   @db.Text
  judgingCriteria String   @db.Text
  position        Int      @default(0)
  isOpen          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  awardYear    AwardYear           @relation(fields: [awardYearId], references: [id], onDelete: Cascade)
  candidacies  Candidacy[]
  honours      Honour[]
  assignments  JudgingAssignment[]
  sponsorships Sponsorship[]

  @@unique([awardYearId, slug])
  @@index([awardYearId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Nominations
//
// Two different things live here, and keeping them apart is the point:
//
//   Candidacy  — a creator's candidacy in one category of one season. This is
//                what PALMA judges, and what carries an honour.
//   Nomination — one person's signal that a creator deserves consideration.
//
// Many nominations point at one candidacy. Nomination volume is an input to
// discovery, never to the outcome: nothing in the judging path reads the count.
// ─────────────────────────────────────────────────────────────────────────────

/// A person who has nominated. Deliberately not a PALMA account: an email
/// address, verified once, and nothing else.
model Nominator {
  id       String @id @default(cuid())
  email    String @unique
  /// Normalised form (lower-cased, provider aliases folded) so one person
  /// cannot become several nominators through address tricks.
  emailKey String @unique

  verifiedAt      DateTime?
  lastNominatedAt DateTime?
  isBlocked       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  nominations   Nomination[]
  verifications NominatorVerification[]

  @@index([verifiedAt])
}

/// A short-lived email verification code. Codes are stored hashed, expire, and
/// are single-use; attempts are counted so a code cannot be brute-forced.
model NominatorVerification {
  id          String    @id @default(cuid())
  nominatorId String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  ipHash      String?
  createdAt   DateTime  @default(now())

  nominator Nominator @relation(fields: [nominatorId], references: [id], onDelete: Cascade)

  @@index([nominatorId])
  @@index([expiresAt])
}

model Candidacy {
  id          String          @id @default(cuid())
  reference   String          @unique
  awardYearId String
  categoryId  String
  creatorId   String
  status      CandidacyStatus @default(under_review)

  /// Count of counted nominations. Operational and judging-blind: it is shown
  /// to administrators, never to judges, and never to the public.
  nominationCount  Int       @default(0)
  firstNominatedAt DateTime?
  lastNominatedAt  DateTime?

  /// Raised when integrity screening sees coordinated or automated activity.
  integrityFlag Boolean   @default(false)
  integrityNote String?   @db.Text
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNote    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  awardYear   AwardYear           @relation(fields: [awardYearId], references: [id])
  category    Category            @relation(fields: [categoryId], references: [id])
  creator     Creator             @relation(fields: [creatorId], references: [id])
  nominations Nomination[]
  evidence    CandidacyEvidence[]
  assignments JudgingAssignment[]
  scores      JudgingScore[]
  honours     Honour[]
  reports     Report[]            @relation("ReportSubjectCandidacy")

  @@unique([awardYearId, categoryId, creatorId])
  @@index([status])
  @@index([awardYearId, categoryId])
}

model Nomination {
  id          String           @id @default(cuid())
  reference   String           @unique
  candidacyId String
  nominatorId String
  source      NominationSource @default(organic)
  status      NominationStatus @default(pending_verification)

  /// A sentence or two. No essay, no evidence, no attachments.
  reason String @db.Text

  /// Set when the nomination arrived through a creator's own link.
  referralSlug String?

  ipHash           String?
  userAgentHash    String?
  integrityScore   Int      @default(0)
  integritySignals String[]

  createdAt       DateTime  @default(now())
  verifiedAt      DateTime?
  countedAt       DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  candidacy Candidacy @relation(fields: [candidacyId], references: [id], onDelete: Cascade)
  nominator Nominator @relation(fields: [nominatorId], references: [id], onDelete: Cascade)

  /// One nomination per person, per creator, per category, per season —
  /// enforced here rather than in the form.
  @@unique([nominatorId, candidacyId])
  @@index([status])
  @@index([candidacyId])
}

/// Evidence is gathered by PALMA, not demanded of the audience. It is a private
/// reference for authorised judges and is never published.
model CandidacyEvidence {
  id          String       @id @default(cuid())
  candidacyId String
  kind        EvidenceKind @default(external_link)
  label       String
  url         String?
  note        String?      @db.Text
  addedById   String?
  createdAt   DateTime     @default(now())

  candidacy Candidacy @relation(fields: [candidacyId], references: [id], onDelete: Cascade)

  @@index([candidacyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Judging
// ─────────────────────────────────────────────────────────────────────────────

model Judge {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String
  title        String?
  organisation String?
  biography    String?  @db.Text
  countryCode  String?  @db.Char(2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships JudgePanelMembership[]
  assignments JudgingAssignment[]
  conflicts   JudgeConflict[]
  scores      JudgingScore[]
}

model JudgePanelMembership {
  id          String   @id @default(cuid())
  judgeId     String
  awardYearId String
  isChair     Boolean  @default(false)
  createdAt   DateTime @default(now())

  judge     Judge     @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  awardYear AwardYear @relation(fields: [awardYearId], references: [id], onDelete: Cascade)

  @@unique([judgeId, awardYearId])
}

model JudgeConflict {
  id           String         @id @default(cuid())
  judgeId      String
  creatorId    String?
  candidacyId  String?
  kind         ConflictKind
  status       ConflictStatus @default(declared)
  note         String?        @db.Text
  declaredAt   DateTime       @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  judge Judge @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@index([judgeId])
  @@index([candidacyId])
}

model JudgingAssignment {
  id          String           @id @default(cuid())
  judgeId     String
  candidacyId String
  categoryId  String
  status      AssignmentStatus @default(assigned)
  assignedAt  DateTime         @default(now())
  completedAt DateTime?
  recusedAt   DateTime?

  judge     Judge         @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  candidacy Candidacy     @relation(fields: [candidacyId], references: [id], onDelete: Cascade)
  category  Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  score     JudgingScore?

  @@unique([judgeId, candidacyId])
  @@index([status])
}

/// Scores are immutable once submitted. Corrections are performed by an
/// authorised administrator and leave both records in the audit log.
model JudgingScore {
  id             String    @id @default(cuid())
  assignmentId   String    @unique
  judgeId        String
  candidacyId    String
  /// Scored 0-10 each. The weights live in src/domain/judging.ts, published
  /// on /about/judging, and are never stored per row: a score card is the
  /// judge's marks, and the weighting is the institution's, fixed for a season.
  achievement    Int
  quality        Int
  impact         Int
  consistency    Int
  audience       Int
  fit            Int
  /// The weighted total, in tenths of a point out of 100. Integer by
  /// construction: whole marks times whole percentages.
  total          Int
  remarks        String?   @db.Text
  submittedAt    DateTime  @default(now())
  correctedAt    DateTime?
  correctedById  String?
  correctionNote String?   @db.Text

  assignment JudgingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  judge      Judge             @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  candidacy  Candidacy         @relation(fields: [candidacyId], references: [id], onDelete: Cascade)

  @@index([candidacyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Honours, achievements & verification
// ─────────────────────────────────────────────────────────────────────────────

/// A single table carries shortlist, finalist and winner states so that the
/// Roll of Honour has one authoritative source per (year, category, creator).
model Honour {
  id String @id @default(cuid())

  awardYearId   String
  /// Null for THE PALMA only. Every other honour belongs to a category; THE
  /// PALMA is conferred on a career rather than in a contest, so there is no
  /// category to point at. The partial unique index below is what keeps it to
  /// one a season, because a null category cannot be held unique by the
  /// composite key (Postgres treats nulls as distinct).
  categoryId    String?
  creatorId     String
  candidacyId   String?
  kind          HonourKind
  state         HonourState @default(active)
  position      Int         @default(0)
  citation      String?     @db.Text
  announcedAt   DateTime?
  revokedAt     DateTime?
  revokedReason String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  awardYear   AwardYear    @relation(fields: [awardYearId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  creator     Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  candidacy   Candidacy?   @relation(fields: [candidacyId], references: [id], onDelete: SetNull)
  achievement Achievement?

  @@unique([awardYearId, categoryId, creatorId, kind])
  @@index([kind, state])
}

/// The permanent, publicly citable record of an honour.
model Achievement {
  id           String      @id @default(cuid())
  honourId     String      @unique
  creatorId    String
  code         String      @unique
  kind         HonourKind
  state        HonourState @default(active)
  year         Int
  categoryName String
  creatorName  String
  issuedAt     DateTime    @default(now())
  revokedAt    DateTime?

  honour              Honour               @relation(fields: [honourId], references: [id], onDelete: Cascade)
  creator             Creator              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  verificationRecords VerificationRecord[]
  physicalItem        AwardPhysicalItem?
  markLicences        AwardMarkLicence[]

  @@index([creatorId])
  @@index([year])
}

/// Signed, immutable proof for /verify/PM-YYYY-XXXX. The signature binds the
/// achievement's identity fields so a record cannot be forged or edited.
model VerificationRecord {
  id            String    @id @default(cuid())
  achievementId String
  code          String    @unique
  signature     String
  payloadDigest String
  issuedAt      DateTime  @default(now())
  lastViewedAt  DateTime?
  viewCount     Int       @default(0)

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@index([achievementId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Sponsors — deliberately isolated from judging
// ─────────────────────────────────────────────────────────────────────────────

/// A commercial partner.
///
/// Everything below the public fields is internal and never rendered on a
/// public page: contact names, agreement state and notes are PALMA's side of a
/// business relationship, not part of the record.
model Sponsor {
  id         String  @id @default(cuid())
  slug       String  @unique
  /// Shown publicly.
  name       String
  summary    String? @db.Text
  websiteUrl String?
  logoUrl    String?
  isActive   Boolean @default(true)

  /// Internal, commercial. Never public.
  legalName       String?
  tradingName     String?
  status          SponsorStatus   @default(prospect)
  relationship    String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  internalNotes   String?         @db.Text
  agreementStatus AgreementStatus @default(none)
  startsAt        DateTime?
  endsAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sponsorships   Sponsorship[]
  campaigns      Campaign[]
  opportunities  Opportunity[]
  productEntries ProductEntry[]

  @@index([status])
}

/// A sponsor's association with one thing they funded.
///
/// The architecture in one line: **association follows the thing they funded.**
/// A category sponsor appears on that category and the finalist and winner
/// pages beneath it. An event sponsor appears on that event. An editorial
/// sponsor appears on that article. A principal partner appears at the level of
/// the institution itself. Nothing bleeds: buying a category does not put a
/// logo on the Journal, and buying the Journal does not put one on a category.
///
/// It buys the association and nothing else. It cannot touch nomination
/// eligibility, weighting, judging, assignment, scores or selection — see
/// OUTCOME_PERMISSIONS and the firewall tests.
model Sponsorship {
  id          String               @id @default(cuid())
  sponsorId   String
  awardYearId String
  placement   SponsorshipPlacement @default(category)

  /// Exactly one of these is set, matching `placement`. A principal partnership
  /// sets none: it attaches to the season itself.
  categoryId String?
  eventId    String?
  articleId  String?

  packageId String?
  tier      SponsorTier @default(supporting)
  billing   String?
  startsAt  DateTime?
  endsAt    DateTime?

  /// How the attribution reads. "Presented by" for a category, "In partnership
  /// with" for an event — the desk chooses the register, not the sponsor.
  attribution String?

  /// An association is not live until an administrator approves it. The
  /// moderation desk proposes placements; approval is a commercial decision.
  isApproved   Boolean   @default(false)
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sponsor   Sponsor             @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  awardYear AwardYear           @relation(fields: [awardYearId], references: [id], onDelete: Cascade)
  category  Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  event     PalmaEvent?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  article   Article?            @relation(fields: [articleId], references: [id], onDelete: SetNull)
  package   SponsorshipPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@unique([sponsorId, awardYearId, placement, categoryId, eventId, articleId])
  @@index([isApproved])
  @@index([placement])
  @@index([categoryId])
  @@index([eventId])
  @@index([articleId])
}

enum SponsorshipPlacement {
  /// A category, and the finalist and winner pages beneath it.
  category
  /// One PALMA event.
  event
  /// One Journal article, labelled as partner content.
  editorial
  /// The institution: the partners page, the season page, the ceremony.
  principal
}

// ─────────────────────────────────────────────────────────────────────────────
// Claims, staff notes & manual verification
// ─────────────────────────────────────────────────────────────────────────────

/// A request to control an existing PALMA creator record.
///
/// A claim never creates a creator. The record already exists — PALMA made it
/// when the creator was first nominated — and an approved claim only links a
/// User to it. There is no second profile, and no route by which one appears.
model CreatorClaim {
  id        String      @id @default(cuid())
  reference String      @unique
  creatorId String
  userId    String
  status    ClaimStatus @default(submitted)

  /// What the claimant says about themselves. Supplied to establish control of
  /// the identity, not to become the public record.
  claimedIdentity String  @db.Text
  supportingNote  String? @db.Text
  contactEmail    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set when PALMA asks for more before deciding.
  informationRequestedAt   DateTime?
  informationRequestedNote String?   @db.Text
  escalatedAt              DateTime?

  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?   @db.Text

  creator   Creator            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  user      User               @relation("ClaimClaimant", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?              @relation("ClaimReviewer", fields: [decidedById], references: [id], onDelete: SetNull)
  links     CreatorClaimLink[]

  /// One open claim per person per creator. A rejected claim does not bar a
  /// better-evidenced one later, so this is not a hard unique on the pair.
  @@index([status])
  @@index([creatorId])
  @@index([userId])
}

/// Links a claimant offers as evidence of control. Never published.
model CreatorClaimLink {
  id      String @id @default(cuid())
  claimId String
  label   String
  url     String

  claim CreatorClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

/// A secure, single-use invitation to claim a record PALMA created first.
/// The token is stored hashed: the link is knowledge, not a database row.
model ClaimInvitation {
  id         String    @id @default(cuid())
  creatorId  String
  tokenHash  String    @unique
  issuedById String?
  expiresAt  DateTime
  usedAt     DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  creator  Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  issuedBy User?   @relation("InvitationIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([creatorId])
}

/// Staff-only working notes on a creator record. Never public, never shown to
/// the creator, and kept structurally apart from anything that is.
model CreatorNote {
  id        String   @id @default(cuid())
  creatorId String
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  author  User?   @relation("CreatorNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([creatorId])
}

/// Manual age assurance, for the cases the provider cannot settle.
///
/// PALMA's permanent record is a status, a reference and a hash — never the
/// documents. Where media is received for a manual check it is held in a
/// restricted workspace outside this database and deleted on decision; this
/// row records that the deletion happened and when.
model VerificationCase {
  id        String                 @id @default(cuid())
  reference String                 @unique
  creatorId String
  reason    VerificationCaseReason
  status    VerificationCaseStatus @default(open)

  openedAt     DateTime  @default(now())
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?   @db.Text

  /// The outcome PALMA keeps. No documents, no date of birth, no address.
  resultHash        String?
  providerReference String?

  /// The privacy lifecycle, made explicit so an operator can see it.
  mediaReceivedAt DateTime?
  mediaDeletedAt  DateTime?

  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("VerificationCaseReviewer", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([creatorId])
}

/// The gravest actions need two administrators.
///
/// A permanent ban and the revocation of an honour are the two things PALMA
/// cannot take back cleanly, so neither is one person's decision made at
/// speed. One administrator proposes with a reason; a different one executes.
/// The proposal, the reason and both names are part of the record.
model ConsequentialAction {
  id            String                  @id @default(cuid())
  kind          ConsequentialActionKind
  entityType    String
  entityId      String
  /// What the reader of the audit log needs to know without a join.
  subject       String
  reason        String                  @db.Text
  requestedById String
  createdAt     DateTime                @default(now())

  approvedById    String?
  approvedAt      DateTime?
  executedAt      DateTime?
  cancelledAt     DateTime?
  cancelledReason String?   @db.Text

  requestedBy User  @relation("ConsequentialRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  approvedBy  User? @relation("ConsequentialApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([executedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Journal
// ─────────────────────────────────────────────────────────────────────────────

model ArticleCategory {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  summary  String?
  position Int     @default(0)

  articles Article[]
}

model Article {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  standfirst     String        @db.Text
  body           String        @db.Text
  status         ArticleStatus @default(draft)
  categoryId     String?
  authorId       String?
  authorName     String
  heroImageUrl   String?
  heroImageAlt   String?
  readingMinutes Int           @default(4)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?            @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  /// Set only on partner content, which must say so on its face. Sponsors
  /// never publish: an editor approves, and the association is recorded.
  sponsorId           String?
  sponsoredLabel      String?
  sponsorApprovedAt   DateTime?
  sponsorApprovedById String?

  sponsorships Sponsorship[]

  @@index([status, publishedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrity: reports, moderation, audit, notifications
// ─────────────────────────────────────────────────────────────────────────────

model Report {
  id             String       @id @default(cuid())
  reason         ReportReason
  status         ReportStatus @default(open)
  detail         String       @db.Text
  reporterId     String?
  creatorId      String?
  candidacyId    String?
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?
  resolutionNote String?      @db.Text

  reporter  User?              @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  creator   Creator?           @relation("ReportSubjectCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  candidacy Candidacy?         @relation("ReportSubjectCandidacy", fields: [candidacyId], references: [id], onDelete: SetNull)
  actions   ModerationAction[]

  @@index([status])
}

model ModerationAction {
  id         String               @id @default(cuid())
  reportId   String?
  actorId    String
  kind       ModerationActionKind
  entityType String
  entityId   String
  rationale  String               @db.Text
  createdAt  DateTime             @default(now())

  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  actor  User    @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

/// Append-only. Nothing of institutional consequence happens silently.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  Role?
  actorLabel String?
  action     String
  entityType String
  entityId   String
  summary    String?
  before     Json?
  after      Json?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

/// The Dossier: everything PALMA has told this account, kept.
///
/// An entry is written whether or not the matching email was sent, so an
/// account that muted a channel or whose address bounced can still find out
/// what happened. The Dossier is the record; email is only how it travels.
model Notification {
  id      String              @id @default(cuid())
  userId  String
  channel NotificationChannel @default(in_app)

  /// The template that produced it — see src/server/email/register.ts.
  kind    String  @default("notice")
  subject String
  body    String  @db.Text
  href    String?

  /// Entries PALMA will not let an account dismiss unread.
  isImportant Boolean @default(false)

  readAt     DateTime?
  archivedAt DateTime?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Every message PALMA has tried to send, and what became of it.
///
/// Written before the provider is called and updated after, so a message that
/// failed is as visible as one that arrived. This is what /admin/communications
/// reads: an institution that cannot say whether it told someone has not told
/// them.
model EmailDelivery {
  id       String @id @default(cuid())
  /// Template key from the register.
  template String
  /// The address it was sent from — which voice of the institution spoke.
  from     String
  to       String
  subject  String

  status     EmailDeliveryStatus @default(queued)
  /// Resend's id, when the provider accepted it.
  providerId String?
  /// Why it did not go, in the operator's words rather than the provider's.
  detail     String?

  /// Who it concerned, when PALMA knows.
  userId    String?
  creatorId String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?
  /// When the provider last told us something about it.
  settledAt DateTime?

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  creator Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([template, createdAt])
  @@index([status, createdAt])
  @@index([to])
  @@index([providerId])
}

/// An address PALMA has stopped writing to, and why.
///
/// Written when a message bounces or is reported as spam. It is not a
/// punishment and not permanent — a person whose mailbox was full, or who
/// changed provider, comes straight off it by proving the address again. What
/// it prevents is PALMA spending months writing to an address that has been
/// telling us for months that it does not work.
model SuppressedAddress {
  id          String            @id @default(cuid())
  email       String            @unique
  reason      SuppressionReason
  /// What the provider actually said, for the operator reading the list.
  detail      String?
  /// The delivery that caused it, so the decision can be traced.
  deliveryId  String?
  createdAt   DateTime          @default(now())
  /// Set when an operator or the address holder clears it.
  clearedAt   DateTime?
  clearedById String?

  @@index([reason])
}

enum SuppressionReason {
  /// Permanently undeliverable: no such mailbox, domain gone.
  hard_bounce
  /// Temporarily undeliverable often enough to stop trying.
  soft_bounce
  /// Reported as spam.
  complaint
}

/// A single-use password reset.
///
/// Stored as a SHA-256 hash, so a database copy cannot be turned into an
/// account. Requesting one never says whether the address has an account.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  /// Coarse origin of the request, for the security notice. Never a raw address.
  requestHash String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A request to move an account to a different address.
///
/// Confirmed from the new address, and announced to the old one — so losing
/// control of an inbox does not silently lose you the account.
model EmailChangeRequest {
  id          String    @id @default(cuid())
  userId      String
  newEmail    String
  tokenHash   String    @unique
  expiresAt   DateTime
  confirmedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One person's subscription to one PALMA list.
///
/// Keyed by address rather than by account, because most of the people who
/// want to follow a season are not creators and never will be — and because
/// one address must have one answer per list, whether or not it also has an
/// account. Where the address does belong to an account, `userId` links them
/// so the preference centre and the public footer are the same subscription.
///
/// Every list is independently opt-in, and leaving one never touches another:
/// somebody who no longer wants partner offers has not asked to stop being
/// told who won.
model EmailSubscription {
  id     String        @id @default(cuid())
  email  String
  type   EmailListType
  userId String?

  status SubscriptionStatus @default(pending)

  /// Confirmation and unsubscribe both ride this one hash.
  tokenHash String @unique
  /// Where it came from — the footer, the preference centre, an event.
  source    String @default("site")

  /// What PALMA has to be able to demonstrate: what was agreed, and when.
  consentVersion String?
  consentAt      DateTime?
  /// Coarse origin of the consent. Never a raw address.
  consentHash    String?

  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([email, type])
  @@index([type, status])
  @@index([userId])
}

enum EmailListType {
  /// Nominations opening, finalists, winners, the season in review.
  awards
  /// Editorial: interviews, profiles, creator-culture features.
  journal
  /// Ticket releases, invitations, event information.
  events
  /// Curated creator opportunities.
  opportunities
  /// Commercial messages from PALMA partners, labelled as such.
  partner_offers
}

enum SubscriptionStatus {
  pending
  confirmed
  unsubscribed
}

/// An issue sent to one of PALMA's lists, kept.
///
/// Sent mail used to exist only in other people's inboxes, so a reader who
/// joined today could not read the last one and PALMA had no record of what
/// it had said. An institution that keeps a permanent record of everybody
/// else's achievements can keep its own letters.
model Dispatch {
  id     String        @id @default(cuid())
  /// Which list it went to. Targeting is by list, always.
  type   EmailListType @default(journal)
  /// Sequential within its list: "No. 4".
  number Int
  slug   String        @unique

  subject    String
  standfirst String  @db.Text
  body       String  @db.Text
  linkLabel  String?
  linkUrl    String?

  /// Set on partner content, which must say so on its face.
  sponsorId String?

  /// How many confirmed subscribers it went to, and how many did not take it.
  sentCount   Int @default(0)
  failedCount Int @default(0)

  sentById String?
  sentAt   DateTime @default(now())

  @@unique([type, number])
  @@index([sentAt])
}

/// A creator's portrait.
///
/// Held as bytes in PostgreSQL rather than in a bucket, because PALMA's whole
/// read layer is "one source of truth and no fallback", and a few hundred
/// re-encoded portraits are tens of megabytes. It also keeps the institution
/// out of a hotlinking arrangement where some other host learns the IP address
/// of everyone who looks at a PALMA record.
///
/// What is stored is never the file that was uploaded. PALMA decodes it,
/// discards every scrap of metadata — a phone photograph carries GPS
/// coordinates, and a portrait that leaked somebody's home address would be
/// the exact failure the rest of this schema is arranged to prevent — resizes
/// it, and re-encodes it. The original is never written anywhere.
///
/// A portrait is a claimed-record field. PALMA does not find a picture of an
/// unclaimed creator and put it on their record; the only way one exists is
/// that the person in it uploaded it.
model CreatorPortrait {
  id        String @id @default(cuid())
  creatorId String @unique

  /// Re-encoded by PALMA. Never the bytes that arrived.
  ///
  /// Set only when object storage is not configured. With R2 in place the
  /// bytes live there and this is null; see storageKey and
  /// src/server/services/portrait-storage.ts.
  data        Bytes?
  /// The R2 object holding the bytes, when R2 is where they went. Null means
  /// they are in `data`. Exactly one of the two is ever set.
  storageKey  String?
  contentType String
  width       Int
  height      Int
  byteSize    Int
  /// Of the stored bytes. Versions the cache and proves what is served.
  checksum    String

  /// The creator's own description of the image, for anyone who cannot see it.
  alt String?

  /// Live from the moment it is uploaded. See PortraitStatus.
  status          PortraitStatus @default(published)
  withdrawnAt     DateTime?
  withdrawnById   String?
  withdrawnReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

/// A portrait is published when it is uploaded, not when somebody approves it.
///
/// PALMA used to hold every upload in a queue until a moderator looked. That
/// bought very little: the people uploading are creators putting a headshot on
/// their own record, and making each of them wait days for a photograph to
/// appear taxed all of them for the rare one. What replaced it is reactive —
/// the upload goes live, the desk can take it down, and the rule it is judged
/// against is stated plainly on the upload form rather than discovered
/// afterwards.
enum PortraitStatus {
  /// On the record, visible to anyone.
  published
  /// Taken down by the desk, with a reason the creator is told. The bytes are
  /// deleted at the same time: PALMA does not keep an image it has removed.
  withdrawn
}

/// An objection to an unclaimed record, under UK GDPR Article 21.
///
/// PALMA writes records about people who never asked, relying on legitimate
/// interests. The balance that makes that lawful only holds while the person
/// named can stop it — so this is a first-class route rather than an inbox, it
/// needs no account, and it needs no reason.
model RecordObjection {
  id        String @id @default(cuid())
  creatorId String

  /// How PALMA can reply. The only personal data an objection needs.
  contactEmail String
  /// Optional. Nobody has to explain why they do not want to be listed.
  note         String? @db.Text

  status       RecordObjectionStatus @default(received)
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?

  createdAt DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([creatorId])
}

enum RecordObjectionStatus {
  received
  /// The record was taken down.
  upheld
  /// Refused — only where an honour has been conferred and the archival
  /// exemption applies. Always explained, always appealable.
  refused
  /// Withdrawn by the person who raised it.
  withdrawn
}

// ─────────────────────────────────────────────────────────────────────────────
// Commercial rails
//
// PALMA's monetisation principle, in one line: never sell the recognition,
// sell the ecosystem around it. Everything in this section is arranged so that
// a commercial relationship can never reach a judging decision — the firewall
// is enforced in `src/lib/auth/rbac.ts` and asserted by tests, not merely
// hidden in the interface.
//
// Almost all of it ships switched off. The rails are laid now so that turning
// a train on later is a configuration change rather than a rewrite.
// ─────────────────────────────────────────────────────────────────────────────

/// The state of one commercial capability, globally or for one season.
///
/// The *catalogue* of features lives in code (`src/domain/features.ts`) so that
/// the set is typed, documented and impossible to invent by inserting a row.
/// This table holds only the state, and a row scoped to an award year beats the
/// global one — turning category sponsorship on for 2028 must not reach back
/// and change what 2027 says happened.
model FeatureSetting {
  id  String @id @default(cuid())
  key String

  /// Null means the global default for this feature.
  awardYearId String?

  enabled Boolean @default(false)
  /// Feature-specific values: prices, limits, copy. Shape declared in code.
  config  Json?

  /// Optional window. Outside it the feature reads as off however `enabled` sits.
  launchAt DateTime?
  endAt    DateTime?

  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  awardYear AwardYear? @relation(fields: [awardYearId], references: [id], onDelete: Cascade)

  @@unique([key, awardYearId])
  @@index([key])
}

/// What PALMA sells, at prices an administrator sets rather than a developer.
model SponsorshipPackage {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text

  /// Minor units — pence — because money in a float is a bug waiting.
  priceMinor Int     @default(0)
  currency   String  @default("GBP")
  /// "One season", "One event", "Twelve months".
  duration   String?

  /// What the buyer receives. Visibility, association, hospitality — never
  /// anything that touches a nomination, a score or an outcome.
  benefits   String[] @default([])
  /// Where it may appear: category, event, journal, newsletter.
  placements String[] @default([])

  /// Null means unlimited. Used by the inventory view.
  maxQuantity Int?
  isAvailable Boolean @default(false)
  isPublic    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sponsorships Sponsorship[]

  @@index([isAvailable])
}

/// A commercial campaign: a sponsor's activity within a season.
model Campaign {
  id        String  @id @default(cuid())
  sponsorId String?
  name      String
  reference String  @unique

  status   CampaignStatus @default(draft)
  startsAt DateTime?
  endsAt   DateTime?
  notes    String?        @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sponsor Sponsor? @relation(fields: [sponsorId], references: [id], onDelete: SetNull)

  @@index([status])
}

enum CampaignStatus {
  draft
  scheduled
  live
  completed
  cancelled
}

enum SponsorStatus {
  prospect
  active
  paused
  expired
  terminated
}

enum AgreementStatus {
  none
  drafted
  sent
  signed
  expired
}

/// An event PALMA runs. Data model only until EVENT_TICKETING is switched on.
model PalmaEvent {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  awardYearId String?

  venue       String?
  /// Never more precise than PALMA needs to publish.
  city        String?
  startsAt    DateTime?
  endsAt      DateTime?
  description String?   @db.Text

  status      EventStatus @default(planned)
  capacity    Int?
  isPublished Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  awardYear    AwardYear?    @relation(fields: [awardYearId], references: [id], onDelete: SetNull)
  ticketTypes  TicketType[]
  sponsorships Sponsorship[]

  @@index([status])
}

enum EventStatus {
  planned
  announced
  on_sale
  sold_out
  held
  cancelled
}

/// A kind of admission. No orders, no payments, no attendees until PALMA sells.
model TicketType {
  id      String @id @default(cuid())
  eventId String

  name        String
  description String?    @db.Text
  priceMinor  Int        @default(0)
  currency    String     @default("GBP")
  capacity    Int?
  /// VIP, table, hospitality — shapes what the ticket admits to.
  kind        TicketKind @default(general)

  isAvailable Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event PalmaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

enum TicketKind {
  general
  premium
  vip
  table
  hospitality
  industry
}

/// A physical trophy, tracked against an achievement that already exists.
///
/// Deliberately downstream of the award: a row here records the manufacture of
/// an object commemorating a decision, and can never be the decision.
model AwardPhysicalItem {
  id            String @id @default(cuid())
  achievementId String @unique

  itemType          String             @default("trophy")
  status            PhysicalItemStatus @default(not_ordered)
  productionStatus  String?
  shippingStatus    String?
  trackingReference String?
  notes             String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum PhysicalItemStatus {
  not_ordered
  ordered
  in_production
  ready
  shipped
  delivered
  replacement
  cancelled
}

/// Permission to use the PALMA mark, granted against an achievement.
///
/// This is what eventually stops somebody putting a fabricated "PALMA Winner"
/// badge on their site: the licence points at a real achievement, and the
/// verification record is still the canonical proof.
model AwardMarkLicence {
  id            String @id @default(cuid())
  achievementId String

  status        LicenceStatus @default(granted)
  permittedUses String[]      @default([])
  startsAt      DateTime?
  endsAt        DateTime?
  revokedAt     DateTime?
  revokedReason String?       @db.Text

  grantedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@index([achievementId])
  @@index([status])
}

enum LicenceStatus {
  granted
  suspended
  revoked
  expired
}

/// Something PALMA passes to creators. Curated, never an open marketplace.
model Opportunity {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String
  summary String  @db.Text
  body    String? @db.Text

  kind      OpportunityKind @default(collaboration)
  sponsorId String?

  /// Where a creator goes to take it up. PALMA brokers nothing itself.
  externalUrl String?
  closesAt    DateTime?

  status      OpportunityStatus @default(draft)
  publishedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sponsor Sponsor? @relation(fields: [sponsorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

enum OpportunityKind {
  collaboration
  brand
  application
  programme
  event
  professional
  partnership
}

enum OpportunityStatus {
  draft
  published
  closed
  withdrawn
}

/// Settings an operator changes without a deployment.
///
/// Deliberately small: anything here is a switch an administrator is trusted to
/// throw at runtime. Secrets stay in the environment — a key in the database is
/// a key in every backup of it.
model SystemSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Durable counters backing nomination-form rate limiting and abuse detection.
model RateLimitCounter {
  id           String   @id @default(cuid())
  bucket       String
  identity     String
  count        Int      @default(0)
  windowEndsAt DateTime
  createdAt    DateTime @default(now())

  @@unique([bucket, identity])
  @@index([windowEndsAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Measurement
//
// PALMA measures its own activity, not its visitors. Both tables below hold
// counts and nothing else: no identifier, no IP, no hash of an IP, no
// user-agent, no session, no timestamp finer than the day. There is deliberately
// nothing here that could be joined to a person, because the surest way to be
// unable to identify somebody is never to hold the thing that would.
//
// See src/domain/measurement.ts for what this does and does not make possible.
// ─────────────────────────────────────────────────────────────────────────────

/// One row per page per day. The whole of PALMA's traffic measurement.
model PageCount {
  id      String   @id @default(cuid())
  /// Pathname only. Query strings are stripped before this is written.
  path    String
  /// The UTC day. Days rather than timestamps: a timestamp is a trail.
  day     DateTime @db.Date
  /// Which part of the institution this page belongs to, resolved at write time.
  surface String
  count   Int      @default(0)

  @@unique([path, day])
  @@index([day])
  @@index([surface, day])
}

/// What people looked for, and whether PALMA had it. Terms only, never who.
model SearchCount {
  id      String   @id @default(cuid())
  /// Trimmed, lower-cased, capped, and never containing an address.
  term    String
  /// Which search this was: the archive, the creator index, and so on.
  scope   String
  day     DateTime @db.Date
  count   Int      @default(0)
  /// Results the last such search returned. Zero is the useful case: it is
  /// PALMA being asked for something it does not have.
  results Int?

  @@unique([scope, term, day])
  @@index([scope, day])
}

// ─────────────────────────────────────────────────────────────────────────────
// The Product Library
//
// Editorial fields and sponsor fields are separated at the column level, not by
// convention. A sponsorship records who paid and the disclosure; it touches no
// field a reader would take as PALMA's opinion. See
// src/domain/product-library.ts for the rule and the test that holds it.
//
// There is no affiliate column here and there never will be one. The outbound
// link is validated to carry no query string at all, which is what makes a
// commission impossible rather than merely discouraged.
// ─────────────────────────────────────────────────────────────────────────────

model ProductEntry {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  brand    String
  category String

  // ── Editorial. Written by PALMA, never shown to a partner before publication.
  /// Out of ten, to one decimal place, stored in tenths so it stays an integer.
  verdict     Int?
  bestFor     String   @db.Text
  strengths   String[]
  limitations String[]
  review      String   @db.Text
  /// Who at PALMA actually used it, where that is true.
  testedBy    String?

  /// Plain https, no query string. Validated in the domain before it is stored.
  externalUrl String?

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  // ── Sponsorship. Disjoint from everything above.
  sponsorId         String?
  sponsorDisclosure String?   @db.Text
  sponsoredAt       DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  sponsor Sponsor? @relation(fields: [sponsorId], references: [id], onDelete: SetNull)

  @@index([isPublished, category])
  @@index([sponsorId])
}
